# ============================================
# Configurações do Servidor Flask
# ============================================
# Copie este arquivo para .env e configure as variáveis
# cp .env.example .env

# ============================================
# SEGURANÇA (OBRIGATÓRIO ALTERAR EM PRODUÇÃO)
# ============================================

# Chave secreta para tokens JWT (autenticação da API)
# Gere uma chave segura: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=sua-chave-jwt-super-secreta-mude-isso

# Chave secreta para sessões Flask (interface web)
# Gere uma chave segura: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=sua-chave-sessao-super-secreta-mude-isso

# ============================================
# PERFORMANCE
# ============================================

# Número de workers do ThreadPool (padrão: 4)
# Para Raspberry Pi 3, mantenha entre 2-4
MAX_WORKERS=4

# ============================================
# FLASK
# ============================================

# Módulo da aplicação Flask
FLASK_APP=servidor_pi.app

# Ambiente: development ou production
# Em produção, use 'production' para desabilitar debug
FLASK_ENV=production

# ============================================
# RECONHECIMENTO FACIAL (Opcional)
# ============================================

# Limiar LBPH para reconhecimento (padrão: 80.0)
# Menor = mais restritivo, maior = mais permissivo
# LBPH_THRESHOLD=80.0

# ============================================
# SEGURANÇA - DETECÇÃO DE INTRUSÃO (Opcional)
# ============================================

# Máximo de tentativas falhas antes de bloquear IP (padrão: 5)
# MAX_FAILED_ATTEMPTS=5

# Duração do bloqueio em minutos (padrão: 15)
# BLOCK_DURATION_MINUTES=15

# ============================================
# BACKUP (Opcional)
# ============================================

# Intervalo de backup automático em horas (padrão: 24)
# BACKUP_INTERVAL_HOURS=24

# Número máximo de backups mantidos (padrão: 10)
# MAX_BACKUPS=10

# ============================================
# CLIENTES (Para cliente_admin e cliente_acesso)
# ============================================

# URL do servidor (configure nos clientes)
# SERVER_URL=http://192.168.1.100:5000
